FROM php:8.3-cli

# Install system packages and PHP extensions
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    zip \
    wget \
    curl \
    libzip-dev \
    libonig-dev \
    libxml2-dev \
    && docker-php-ext-install \
        zip \
        pdo \
        pdo_mysql \
        mbstring \
        xml \
        pcntl \
        sockets

WORKDIR /app

# Create and set permissions for xdebug_traces directory
RUN mkdir -p /app/xdebug_traces && chmod -R 777 /app/xdebug_traces

# Install xdebug
RUN pecl install xdebug-3.3.2
RUN docker-php-ext-enable xdebug

# Remove any existing xdebug configuration
RUN rm -f /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

# Configure xdebug for automatic function tracing
